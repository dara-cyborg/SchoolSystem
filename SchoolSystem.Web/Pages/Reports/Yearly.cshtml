@page
@model SchoolSystem.Web.Pages.Reports.YearlyModel
@{
    ViewData["Title"] = "Yearly Report";
}

<div class="container mt-4">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Yearly Report</h2>
        <a href="/Dashboard" class="btn btn-secondary">Back to Dashboard</a>
    </div>

    @if (!string.IsNullOrEmpty(Model.ReportViewModel.ErrorMessage))
    {
        <div class="alert alert-danger" role="alert">
            @Model.ReportViewModel.ErrorMessage
        </div>
    }
    else
    {
        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-primary text-white">
                <h5 class="mb-0">Student Information</h5>
            </div>
            <div class="card-body">
                <div class="row">
                    <div class="col-md-4"><strong>Name:</strong> @Model.ReportViewModel.StudentName</div>
                    <div class="col-md-4"><strong>Class:</strong> @Model.ReportViewModel.ClassName</div>
                    <div class="col-md-4"><strong>School Year:</strong> @Model.ReportViewModel.SchoolYear</div>
                </div>
            </div>
        </div>

        <div class="card mb-4 shadow-sm">
            <div class="card-header bg-info text-white">
                <h5 class="mb-0">Class Leaderboard</h5>
            </div>
            <div class="card-body p-0">
                <table class="table table-striped table-hover mb-0">
                    <thead class="table-light">
                        <tr>
                            <th>Student ID</th>
                            <th>Total Score</th>
                            <th>Rank</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var entry in Model.ReportViewModel.Entries.OrderBy(e => e.Rank))
                        {
                            <tr class="@(entry.StudentId == Model.ReportViewModel.StudentId ? "table-primary fw-bold" : "")">
                                <td>@entry.StudentId</td>
                                <td>@entry.TotalScore</td>
                                <td>@entry.Rank</td>
                            </tr>
                        }
                        @if (!Model.ReportViewModel.Entries.Any())
                        {
                            <tr>
                                <td colspan="3" class="text-center text-muted py-3">No scores recorded for this year.</td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
            <div class="card-footer bg-light">
                <div class="row text-center">
                    <div class="col-md-6 border-end">
                        <h6 class="text-muted mb-1">My Total Score</h6>
                        <h4 class="mb-0 text-primary">@Model.ReportViewModel.TotalScore</h4>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">My Class Rank</h6>
                        <h4 class="mb-0 text-success">#@Model.ReportViewModel.Rank</h4>
                    </div>
                </div>
            </div>
        </div>

        <div class="card shadow-sm">
            <div class="card-header bg-warning text-dark">
                <h5 class="mb-0">Attendance Summary</h5>
            </div>
            <div class="card-body">
                <div class="row text-center">
                    <div class="col-md-6 border-end">
                        <h6 class="text-muted mb-1">Informed Absences</h6>
                        <h4 class="mb-0">@Model.ReportViewModel.InformedAbsences</h4>
                    </div>
                    <div class="col-md-6">
                        <h6 class="text-muted mb-1">Uninformed Absences</h6>
                        <h4 class="mb-0 text-danger">@Model.ReportViewModel.UninformedAbsences</h4>
                    </div>
                </div>
            </div>
        </div>
    }
</div>
