@page
@model SchoolSystem.Web.Pages.Dashboard.IndexModel
@{
    ViewData["Title"] = "Parent Portal";
}

<div class="container mt-4">
    <div class="page-header">
        <h1>My Children</h1>
    </div>

    @if (Model.Children.Count == 0)
    {
        <div class="alert alert-info" role="alert">
            <h4 class="alert-heading">No children found</h4>
            <p>You don't have any children linked to your account yet. Please contact the school administrator.</p>
        </div>
    }
    else
    {
        <div class="students-grid">
            @foreach (var child in Model.Children)
            {
                <div class="student-card">
                    <div class="student-header">
                        <h3 class="student-name">@child.StudentName</h3>
                    </div>
                    <div class="student-details">
                        <div class="detail-row">
                            <span class="detail-label">Class</span>
                            <span class="detail-value">@child.ClassName</span>
                        </div>
                        <div class="detail-row">
                            <span class="detail-label">School Year</span>
                            <span class="detail-value">@child.SchoolYear</span>
                        </div>
                        @if (!string.IsNullOrEmpty(child.LatestReportSummary))
                        {
                            <div class="detail-row">
                                <span class="detail-label">Latest Report</span>
                                <span class="detail-value">@child.LatestReportSummary</span>
                            </div>
                        }
                    </div>
                    <div class="student-actions">
                        @if (child.LatestMonthlyReportId.HasValue)
                        {
                            <a asp-page="/Reports/Monthly"
                               asp-route-studentId="@child.StudentId"
                               asp-route-reportId="@child.LatestMonthlyReportId"
                               class="action-btn">Monthly</a>
                        }
                        else
                        {
                            <a asp-page="/Reports/Monthly" asp-route-studentId="@child.StudentId" class="action-btn">Monthly</a>
                        }

                        @if (child.LatestSemesterReportId.HasValue)
                        {
                            <a asp-page="/Reports/Semester"
                               asp-route-studentId="@child.StudentId"
                               asp-route-reportId="@child.LatestSemesterReportId"
                               class="action-btn">Semester</a>
                        }
                        else
                        {
                            <a asp-page="/Reports/Semester" asp-route-studentId="@child.StudentId" class="action-btn">Semester</a>
                        }

                        @if (child.LatestYearlyReportId.HasValue)
                        {
                            <a asp-page="/Reports/Yearly"
                               asp-route-studentId="@child.StudentId"
                               asp-route-reportId="@child.LatestYearlyReportId"
                               class="action-btn">Yearly</a>
                        }
                        else
                        {
                            <a asp-page="/Reports/Yearly" asp-route-studentId="@child.StudentId" class="action-btn">Yearly</a>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

<style>
    .page-header {
        margin-bottom: 2rem;
    }
    
    .page-header h1 {
        font-size: 1.75rem;
        font-weight: 600;
        color: var(--primary);
    }

    .students-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
        gap: 1.5rem;
    }

    .student-card {
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: var(--radius);
        padding: 1.5rem;
        transition: var(--transition);
    }

    .student-card:hover {
        box-shadow: var(--shadow-md);
        transform: translateY(-2px);
    }

    .student-header {
        margin-bottom: 1rem;
        padding-bottom: 1rem;
        border-bottom: 1px solid var(--border);
    }

    .student-name {
        font-size: 1.25rem;
        font-weight: 600;
        color: var(--primary);
        margin: 0;
    }

    .student-details {
        margin-bottom: 1.25rem;
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        padding: 0.5rem 0;
        border-bottom: 1px solid var(--light);
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: var(--text-muted);
        font-size: 0.875rem;
    }

    .detail-value {
        font-weight: 500;
        color: var(--text);
    }

    .student-actions {
        display: flex;
        gap: 0.5rem;
        flex-wrap: wrap;
    }

    .action-btn {
        flex: 1;
        min-width: 80px;
        padding: 0.5rem 0.75rem;
        background: var(--light);
        border: 1px solid var(--border);
        border-radius: var(--radius-sm);
        color: var(--text);
        text-decoration: none;
        font-size: 0.875rem;
        font-weight: 500;
        text-align: center;
        transition: var(--transition);
    }

    .action-btn:hover {
        background: var(--primary);
        border-color: var(--primary);
        color: var(--white);
    }

    @@media (max-width: 767.98px) {
        .students-grid {
            grid-template-columns: 1fr;
        }
        
        .student-actions {
            flex-direction: column;
        }
        
        .action-btn {
            width: 100%;
        }
    }
</style>
