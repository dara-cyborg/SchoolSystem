  "item": [
    {
      "name": "Create Gradebook Entry",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('studentId');",
              "    pm.expect(jsonData).to.have.property('classSubjectId');",
              "    pm.expect(jsonData).to.have.property('label');",
              "    pm.expect(jsonData).to.have.property('score');",
              "    pm.expect(jsonData).to.have.property('maxScore');",
              "    pm.expect(jsonData).to.have.property('createdAt');",
              "});",
              "",
              "pm.test('Created entry has correct values', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.studentId).to.equal(1);",
              "    pm.expect(jsonData.classSubjectId).to.equal(1);",
              "    pm.expect(jsonData.label).to.equal('Quiz 1');",
              "    pm.expect(jsonData.score).to.equal(8.5);",
              "    pm.expect(jsonData.maxScore).to.equal(10);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('gradebookEntryId', jsonData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": 1,\n  \"classSubjectId\": 1,\n  \"label\": \"Quiz 1\",\n  \"score\": 8.5,\n  \"maxScore\": 10\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/gradebook",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "gradebook"
          ]
        }
      }
    },
    {
      "name": "Get Gradebook Entry by ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has required fields', function () {",
              "    var jsonData = pm.response.json();",
