{
  "info": {
    "_postman_id": "t09-gradebook-api",
    "name": "T09 Gradebook API",
    "description": "SchoolSystem Gradebook API for teacher working notes",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
