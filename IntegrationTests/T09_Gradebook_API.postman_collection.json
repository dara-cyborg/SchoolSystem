    {
      "name": "Get Gradebook by Class-Subject",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "});",
              "",
              "pm.test('Each entry has required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.length > 0) {",
              "        jsonData.forEach(function(entry) {",
              "            pm.expect(entry).to.have.property('id');",
              "            pm.expect(entry).to.have.property('studentId');",
              "            pm.expect(entry).to.have.property('classSubjectId');",
              "            pm.expect(entry).to.have.property('label');",
              "            pm.expect(entry).to.have.property('score');",
              "            pm.expect(entry).to.have.property('maxScore');",
              "            pm.expect(entry).to.have.property('createdAt');",
              "        });",
              "    }",
              "});",
              "",
              "pm.test('Entries are ordered by ID', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.length > 1) {",
              "        for (let i = 1; i < jsonData.length; i++) {",
              "            pm.expect(jsonData[i].id).to.be.greaterThanOrEqual(jsonData[i-1].id);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/gradebook/class-subject/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "gradebook",
            "class-subject",
            "1"
          ]
        }
      }
    },
