              "pm.test('Updated entry has new values', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.label).to.equal('Quiz 1 - Revised');",
              "    pm.expect(jsonData.score).to.equal(9.0);",
              "    pm.expect(jsonData.maxScore).to.equal(10);",
              "});",
              "",
              "pm.test('StudentId and ClassSubjectId cannot be modified', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.studentId).to.equal(1);",
              "    pm.expect(jsonData.classSubjectId).to.equal(1);",
              "});"
            ]
          }
        }
