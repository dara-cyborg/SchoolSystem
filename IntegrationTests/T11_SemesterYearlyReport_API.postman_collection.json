  "item": [
    {
      "name": "Submit Semester Report",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('classId');",
              "    pm.expect(jsonData).to.have.property('semester');",
              "    pm.expect(jsonData).to.have.property('schoolYear');",
              "    pm.expect(jsonData).to.have.property('createdAt');",
              "    pm.expect(jsonData).to.have.property('entries');",
              "});",
              "",
              "pm.test('Report entries are an array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData.entries)).to.be.true;",
              "});",
              "",
              "pm.test('Each entry has required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.entries.length > 0) {",
              "        jsonData.entries.forEach(function(entry) {",
              "            pm.expect(entry).to.have.property('studentId');",
              "            pm.expect(entry).to.have.property('totalScore');",
              "            pm.expect(entry).to.have.property('rank');",
              "        });",
              "    }",
              "});",
              "",
              "pm.test('Entries are ordered by rank', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.entries.length > 1) {",
              "        for (let i = 1; i < jsonData.entries.length; i++) {",
              "            pm.expect(jsonData.entries[i].rank).to.be.greaterThan(jsonData.entries[i-1].rank);",
              "        }",
              "    }",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('semesterReportId', jsonData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{homeroomJwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"classId\": 1,\n  \"semester\": 1,\n  \"schoolYear\": 2025\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/semester-reports/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "semester-reports",
            "submit"
          ]
        }
      }
    },
    {
      "name": "Get Semester Report",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response has required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('classId');",
              "    pm.expect(jsonData).to.have.property('semester');",
              "    pm.expect(jsonData).to.have.property('schoolYear');",
              "    pm.expect(jsonData).to.have.property('createdAt');",
              "    pm.expect(jsonData).to.have.property('entries');",
              "});",
              "",
              "pm.test('Retrieved report has correct ID', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.equal(parseInt(pm.environment.get('semesterReportId')));",
              "});",
              "",
              "pm.test('Entries contain correct data', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.entries.length > 0) {",
              "        jsonData.entries.forEach(function(entry) {",
              "            pm.expect(entry.studentId).to.be.a('number');",
              "            pm.expect(entry.totalScore).to.be.a('number');",
              "            pm.expect(entry.rank).to.be.a('number');",
              "        });",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{homeroomJwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/semester-reports/{{semesterReportId}}",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "semester-reports",
            "{{semesterReportId}}"
          ]
        }
      }
    },
