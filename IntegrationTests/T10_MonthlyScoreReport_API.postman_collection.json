  "item": [
    {
      "name": "Submit Monthly Score",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 201 Created', function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test('Response has required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData).to.have.property('id');",
              "    pm.expect(jsonData).to.have.property('studentId');",
              "    pm.expect(jsonData).to.have.property('classSubjectId');",
              "    pm.expect(jsonData).to.have.property('month');",
              "    pm.expect(jsonData).to.have.property('schoolYear');",
              "    pm.expect(jsonData).to.have.property('finalScore');",
              "    pm.expect(jsonData).to.have.property('isLocked');",
              "});",
              "",
              "pm.test('Score is not locked on initial submission', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.isLocked).to.be.false;",
              "});",
              "",
              "pm.test('Created score has correct values', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.studentId).to.equal(1);",
              "    pm.expect(jsonData.classSubjectId).to.equal(1);",
              "    pm.expect(jsonData.month).to.equal(3);",
              "    pm.expect(jsonData.schoolYear).to.equal(2025);",
              "    pm.expect(jsonData.finalScore).to.equal(85.5);",
              "});",
              "",
              "if (pm.response.code === 201) {",
              "    var jsonData = pm.response.json();",
              "    pm.environment.set('monthlyScoreId', jsonData.id);",
              "}"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{jwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"studentId\": 1,\n  \"classSubjectId\": 1,\n  \"month\": 3,\n  \"schoolYear\": 2025,\n  \"finalScore\": 85.5\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/monthly-scores/submit",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "monthly-scores",
            "submit"
          ]
        }
      }
