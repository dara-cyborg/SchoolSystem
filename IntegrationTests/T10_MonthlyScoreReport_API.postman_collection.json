              "});",
              "",
              "pm.test('Retrieved report has correct ID', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.id).to.equal(parseInt(pm.environment.get('monthlyReportId')));",
              "});",
              "",
              "pm.test('Entries contain correct data', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.entries.length > 0) {",
              "        jsonData.entries.forEach(function(entry) {",
              "            pm.expect(entry.studentId).to.be.a('number');",
              "            pm.expect(entry.totalScore).to.be.a('number');",
              "            pm.expect(entry.rank).to.be.a('number');",
              "        });",
              "    }",
              "});"
            ]
          }
        }
      ],
