    {
      "name": "Get Feedback by Monthly Report",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test('Status code is 200 OK', function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test('Response is an array', function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(Array.isArray(jsonData)).to.be.true;",
              "});",
              "",
              "pm.test('Feedback entries have required fields', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.length > 0) {",
              "        jsonData.forEach(function(feedback) {",
              "            pm.expect(feedback).to.have.property('id');",
              "            pm.expect(feedback).to.have.property('parentUserId');",
              "            pm.expect(feedback).to.have.property('reportType');",
              "            pm.expect(feedback).to.have.property('message');",
              "        });",
              "    }",
              "});",
              "",
              "pm.test('Feedback is ordered by ID', function () {",
              "    var jsonData = pm.response.json();",
              "    if (jsonData.length > 1) {",
              "        for (let i = 1; i < jsonData.length; i++) {",
              "            pm.expect(jsonData[i].id).to.be.greaterThan(jsonData[i-1].id);",
              "        }",
              "    }",
              "});"
            ]
          }
        }
      ],
      "request": {
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{homeroomJwtToken}}",
              "type": "string"
            }
          ]
        },
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/feedback/report/monthly/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "feedback",
            "report",
            "monthly",
            "1"
          ]
        }
      }
    },
