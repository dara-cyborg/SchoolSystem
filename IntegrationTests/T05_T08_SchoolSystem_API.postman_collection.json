    {
      "name": "T05 Users",
      "item": [
        {
          "name": "GET Users (Paged)",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/users?page=1&pageSize=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status code is 200', function () {",
                  "    pm.response.to.have.status(200);",
                  "});",
                  "",
                  "const response = pm.response.json();",
                  "pm.test('Paged response shape is valid', function () {",
                  "    pm.expect(response).to.have.property('items');",
                  "    pm.expect(response.items).to.be.an('array');",
                  "    pm.expect(response).to.have.property('totalCount');",
                  "    pm.expect(response).to.have.property('page');",
                  "    pm.expect(response).to.have.property('pageSize');",
                  "    pm.expect(response).to.have.property('totalPages');",
                  "});",
                  "",
                  "if (Array.isArray(response.items) && response.items.length > 0 && response.items[0].id) {",
                  "    pm.collectionVariables.set('userId', String(response.items[0].id));",
                  "}"
                ]
              }
            }
          ]
        },
